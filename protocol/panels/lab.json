{
  "id": "lab",
  "title": "LAB · EXPERIMENTAL PANELS",
  "fw": "virtual-0.1",
  "sections": [
    {
      "title": "CROSS-POINTER",
      "items": [
        {
          "type": "matrix",
          "id": "mx_xp",
          "label": "FLY TO THE DOT",
          "out": "mx_xp",
          "rows": 9,
          "cols": 9
        },
        {
          "type": "rotary",
          "id": "xp_mode",
          "label": "SHOWS",
          "in": "xp_mode",
          "positions": [
            "NODE",
            "RETRO",
            "PRO",
            "PORT",
            "OFFSET",
            "DRIFT"
          ]
        },
        {
          "type": "seg7",
          "id": "disp_xp_right",
          "label": "RIGHT",
          "digits": 5,
          "out": "disp_xp_right"
        },
        {
          "type": "seg7",
          "id": "disp_xp_up",
          "label": "UP",
          "digits": 5,
          "out": "disp_xp_up"
        },
        {
          "type": "seg7",
          "id": "disp_xp_scale",
          "label": "FULL SCALE",
          "digits": 3,
          "out": "disp_xp_scale",
          "color": "green"
        },
        {
          "type": "annunciator",
          "id": "xp_null_box",
          "cols": 1,
          "cells": [
            {
              "out": "lamp_xp_null",
              "label": "NULL",
              "color": "green"
            }
          ]
        }
      ]
    },
